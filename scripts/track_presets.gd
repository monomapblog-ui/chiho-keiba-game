## 実在の地方競馬場をモデルにしたコース定義。
##
## 一次情報の出典: 地方競馬全国協会(NAR)公式サイト「コース一覧」
## (https://www.keiba.go.jp/guide/course/)および同協会発行
## 「地方競馬総合ガイドブック2024」(https://www.keiba.go.jp/pdf/about/sougou/2024/sougou_3.pdf)。
##
## 「1周の距離」「最終直線の長さ」「コーナーの数」「1-2コーナーが3-4コーナーより
## 小回り」などは上記の公式資料に基づく。一方、1周の中での各区間(コーナー1-2/
## 向正面/コーナー3-4)の正確な区間割りまでは公式資料に数値の記載がないため、
## 全体の長さ(1周距離 - 最終直線)を目安で配分した、ゲームプレイ用の推定値である。
class_name TrackPresets
extends RefCounted

static func kochi() -> TrackData:
	var t := TrackData.new()
	t.track_name = "高知競馬場"
	t.distance_m = 1400.0      # 高知競馬場の実際の開催距離の一つ
	t.lap_distance_m = 1100.0  # 公式: 1周1100m
	t.lane_count = 4

	# 公式: 最終直線230m。残り870m(=1100-230)を
	# 「1-2コーナー(小回り)」「向正面」「3-4コーナー(1-2よりやや緩やか)」に
	# 目安で配分(区間の正確な内訳は非公開のため推定)。
	t.corner_zones = [
		{"start": 0.0, "end": 200.0, "severity": 1.6},    # 1-2コーナー
		{"start": 460.0, "end": 870.0, "severity": 1.3},  # 3-4コーナー
	]
	# 200-460m: 向正面(バックストレッチ)
	# 870-1100m(=1周の終わり): 最終直線(公式230m)

	# 公式/各種情報: 高知競馬場は内側の砂が深く、外を回る馬が多い傾向がある。
	# インコース(1レーン寄り)に居続けると、通常より脚を消耗しやすくしている。
	t.inner_lane_penalty = 0.3

	return t
